# Copy to .env (never committed) and edit. Empty values keep the defaults.

# GBFS discovery file. Feed URLs are always resolved from it at request time.
# Default: the official BIXI root, https://gbfs.velobixi.com/gbfs/gbfs.json
GBFS_DISCOVERY_URL=

# Optional PostgreSQL URL. The API starts without a database.
# Database access and migrations require the postgresql+psycopg driver.
# Example format: postgresql+psycopg://citypulse:PASSWORD@127.0.0.1:5432/citypulse
DATABASE_URL=

# Optional raw response-body retention in days. Empty means no time limit (default).
# Must be greater than zero when set.
RAW_PAYLOAD_RETENTION_DAYS=
